        <mxCell id="e9" value="grava novo evento e status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5b5c58;exitX=1;exitY=0.5;entryX=1;entryY=0.5;fontSize=10;" edge="1" parent="1" source="n_lambdaC" target="n_dynamo">
