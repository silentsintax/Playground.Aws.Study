<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" agent="claude" version="24.0.0" type="device">
  <diagram name="Arquitetura Multi-Clearing" id="arch-multi-clearing">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Main pipeline -->
        <mxCell id="n_kafka" value="Kafka&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Mensagem da operação&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1efe6;strokeColor=#b9b6a8;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_lambdaA" value="Lambda: consumer Kafka&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Valida e grava no DynamoDB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#7ea6cf;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_dynamo" value="DynamoDB: outbox + tracking&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Única fonte da verdade&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ea;strokeColor=#6ea173;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_streams" value="DynamoDB Streams&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Dispara Lambda de envio&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edf7;strokeColor=#9a7cb8;" vertex="1" parent="1">
          <mxGeometry x="60" y="340" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_lambdaB" value="Lambda: envia à clearing&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Gateway multi-clearing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#7ea6cf;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_clearing" value="B3 / SELIC / CIP&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Processa, responde depois&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1efe6;strokeColor=#b9b6a8;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_sns" value="SNS: tópico de resposta&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Notificação assíncrona&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edf7;strokeColor=#9a7cb8;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n_sqs" value="SQS: fila intermediária&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Buffer, retry e DLQ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3edf7;strokeColor=#9a7cb8;" vertex="1" parent="1">
