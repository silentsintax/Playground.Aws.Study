        </mxCell>

        <mxCell id="n_lambdaC" value="Lambda: atualiza DynamoDB&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#5b5c58&quot;&gt;Correlaciona por IdExterno&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3ea;strokeColor=#6ea173;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="200" height="60" as="geometry" />
